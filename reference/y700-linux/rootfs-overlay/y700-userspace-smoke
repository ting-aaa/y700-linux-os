#!/bin/sh
# Executed during PC validation with ARM64 user-mode emulation, not a hardware test.
set -eu
task_tmp=$(mktemp -d /tmp/y700-userspace-smoke.XXXXXX)
trap 'rm -rf -- "$task_tmp"' EXIT HUP INT TERM
printf '#include <iostream>\nint main(){std::cout << 6*7 << "\\n";}\n' > "$task_tmp/check.cpp"
g++ "$task_tmp/check.cpp" -o "$task_tmp/check-cpp"
test "$("$task_tmp/check-cpp")" = 42
printf 'fn main() { println!("{}", 6 * 7); }\n' > "$task_tmp/check.rs"
rustc "$task_tmp/check.rs" -o "$task_tmp/check-rust"
test "$("$task_tmp/check-rust")" = 42
node -e 'const assert=require("node:assert/strict"); const crypto=require("node:crypto"); assert.equal(6*7,42); assert.equal(crypto.createHash("sha256").update("Y700").digest("hex").length,64); console.log("Node native modules OK")'
uv run --offline --no-project --python /usr/bin/python3 python -c 'import platform, ssl, sqlite3; assert platform.machine() == "aarch64"; assert sqlite3.connect(":memory:").execute("select 6*7").fetchone()[0] == 42; print("Python",platform.python_version(),"ARM64 SSL/SQLite OK")'
printf 'C++ and Rust compiled ARM64 programs and produced expected result.\n'
