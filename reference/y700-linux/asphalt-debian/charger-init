#!/bin/busybox sh
export PATH=/bin
/bin/busybox --install -s /bin
fail() { echo 'Charging environment stopped'; while :; do poweroff -f; sleep 1; done; }
trap fail EXIT HUP INT TERM
mount -t proc proc /proc || fail
mount -t sysfs sysfs /sys || fail
mount -t devtmpfs devtmpfs /dev || fail
exec </dev/console >/dev/console 2>&1 || fail
mount -t tmpfs -o mode=0755 tmpfs /run || fail
mount -t tmpfs -o mode=1777 tmpfs /tmp || fail
while read -r module; do insmod "$module" || fail; done < /modules.list
batt=/sys/class/power_supply/qcom-battmgr-bat
/bin/mobile-charger "$batt" /sys/class/power_supply/qcom-battmgr-usb pmic_pwrkey \
  msmdrmfb /sys/class/backlight/ktz8866-backlight "$batt" 0 0 32
fail
