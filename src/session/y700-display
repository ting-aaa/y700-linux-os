#!/usr/bin/env bash
# Y700_TOUCH_SYNC_MANAGED_V2
# Keep the X11 touchscreen and orientation-aware stereo speakers mapped to
# the current DSI display transformation.
set -euo pipefail
export LC_ALL=C
touch='NT36523N Capacitive Touchscreen'
output='DSI-1'
audio_helper='/usr/libexec/y700-audio-orientation'
mode=${1:---sync}
case "$mode" in
    --sync|--watch) test "$#" -le 1 ;;
    --rotate)
        test "$#" -eq 2
        case "$2" in normal|left|right|inverted) ;; *) exit 2;; esac
        ;;
    *) echo 'Usage: y700-display [--sync | --watch | --rotate normal|left|right|inverted]' >&2; exit 2;;
esac
test -n "${DISPLAY:-}" || { echo 'Run inside the tablet Xfce session.' >&2; exit 1; }
test "${XDG_SESSION_TYPE:-x11}" = x11 || { echo 'This helper requires X11.' >&2; exit 1; }
for tool in xinput xrandr flock; do
    command -v "$tool" >/dev/null || { echo "Missing command: $tool" >&2; exit 1; }
done

read_state() {
    id=$(xinput list --id-only "$touch") || return 1
    [[ "$id" =~ ^[0-9]+$ ]] || return 1
    listing=$(xrandr --current) || return 1
    screen=${listing%%$'\n'*}
    line=$(awk -v name="$output" '$1 == name && $2 == "connected" && $0 ~ /[0-9]+x[0-9]+[+][0-9]+[+][0-9]+/ {print}' <<< "$listing")
    test -n "$line"
}

current_rotation() {
    local prefix word rot=normal
    prefix=${line%% (*}
    for word in $prefix; do
        case "$word" in normal|left|right|inverted) rot=$word;; esac
    done
    printf '%s\n' "$rot"
}

sync_audio() {
    local rot="$1"
    if [[ -x "$audio_helper" ]]; then
        "$audio_helper" apply "$rot" >/dev/null 2>&1 || :
    fi
}

read_matrix() {
    local properties
    properties=$(xinput list-props "$id") || return 1
    matrix=$(awk '/^[[:space:]]*Coordinate Transformation Matrix \([0-9]+\):/ {
        sub(/^[^:]*:[[:space:]]*/, ""); print; exit
    }' <<< "$properties")
    [[ -n $matrix ]]
}

if [[ "$mode" == --rotate ]]; then
    read_state || { echo 'Expected one NT36523N touchscreen and an active DSI-1 display.' >&2; exit 1; }
    previous=$(current_rotation)
    xrandr --output "$output" --rotate "$2"
    if ! xinput map-to-output "$id" "$output"; then
        echo 'Touch mapping failed; restoring the previous display direction.' >&2
        xrandr --output "$output" --rotate "$previous"
        xinput map-to-output "$id" "$output" || :
        exit 1
    fi
    sync_audio "$2"
    echo "Display, touch and audio mapped together: $2"
    exit 0
fi

if [[ "$mode" == --sync ]]; then
    read_state || { echo 'Expected one NT36523N touchscreen and an active DSI-1 display.' >&2; exit 1; }
    xinput map-to-output "$id" "$output"
    sync_audio "$(current_rotation)"
    exit 0
fi

# Only one watcher per login user. No root service, calibration change or
# forced display orientation is installed. Mapping follows Xfce settings.
runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
test -d "$runtime"
test -O "$runtime"
exec 9>"$runtime/y700-touch-sync.lock"
flock -n 9 || exit 0
last=''
mapped=''
last_rot=''
while :; do
    if read_state && read_matrix; then
        # XInput maps the panel into the whole root window. Changing an
        # adjacent output can resize the root without moving DSI-1.
        current="$id $screen $line"
        rot=$(current_rotation)
        if [[ $current != "$last" || $matrix != "$mapped" ]]; then
            last=''
            if xinput map-to-output "$id" "$output" && read_matrix; then
                last=$current
                mapped=$matrix
            fi
        fi
        if [[ "$rot" != "$last_rot" ]]; then
            sync_audio "$rot"
            last_rot=$rot
        fi
    else
        # Device/display re-creation during a session is retried safely.
        last=''
    fi
    sleep 1
done
