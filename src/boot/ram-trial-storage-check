# Physical diagnostic policy
fail() {
    echo "y700-ram-trial: $*; powering off" >/dev/console
    poweroff -f
    halt -f
    while :; do sleep 3600; done
}
check_storage() {
    printf '%s\n' "$compat" | grep -Fxq lenovo,asphalt || return 0
    for host in ufshc@1d84000 mmc@8804000; do
        status=/proc/device-tree/soc@0/$host/status
        [ -f "$status" ] && [ "$(tr -d '\000' < "$status")" = disabled ] || fail "storage host active: $host"
    done
    for node in /sys/class/block/sd* /sys/class/block/mmcblk*; do
        [ ! -e "$node" ] || fail "physical storage enumerated: ${node##*/}"
    done
    echo 'y700-ram-trial: physical UFS and SD hosts disabled'
}
# End physical diagnostic policy
