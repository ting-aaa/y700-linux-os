--- a/y700-file-trial-init
+++ b/y700-file-trial-init
@@ -1,5 +1,5 @@
 #!/bin/busybox sh
-# Selected only by the dev12.5 file trial menu entry.
+# Selected only by the dev12.10 file trial menu entry.
 export PATH=/bin
 /bin/busybox --install -s /bin
 mount -t devtmpfs devtmpfs /dev || exit 1
@@ -10,7 +10,7 @@
 umask 077
 exitrd=/run/initramfs
 backing=$exitrd/backing
-images=$backing/var/lib/y700-trial/dev12.5
+images=$backing/var/lib/y700-trial/dev12.10
 rootloop=
 esploop=
 outer=
@@ -41,6 +41,7 @@
     [ -n "$flags" ] && [ "$((0x$flags & 4))" = 0 ]
 }
 case " $(cat /proc/cmdline) " in *' y700.media=file '*) ;; *) fail 'file media option missing' ;; esac
+case " $(cat /proc/cmdline) " in *' y700.release=dev12.10 '*) ;; *) fail 'unexpected release option' ;; esac
 compat=$(tr '\000' '\n' </proc/device-tree/compatible)
 if printf '%s\n' "$compat" | grep -Fxq lenovo,asphalt; then
     [ "$(tr -d '\000' </proc/device-tree/region_country)" = PRC ] || fail 'unexpected board region'
@@ -94,7 +95,17 @@
 for dir in "$backing/var/lib/y700-trial" "$images"; do
     safe_dir "$dir" && [ "$(stat -c %a "$dir")" = 700 ] || fail 'unsafe trial directory'
 done
-private_image "$images/root.ext4" 6442450944 || fail 'unsafe root image'
+if private_image "$images/root.ext4" 6442450944; then
+    expected_blocks=00001800
+elif private_image "$images/root.ext4" 34359738368; then
+    expected_blocks=00008000
+else
+    fail 'unsafe root image'
+fi
+# Require a fully resized 4 KiB ext4 filesystem inside the selected regular file.
+[ "$(hex "$images/root.ext4" 1048 4)" = 02000000 ] &&
+[ "$(hex "$images/root.ext4" 1028 4)" = "$expected_blocks" ] &&
+[ "$(hex "$images/root.ext4" 1360 4)" = 00000000 ] || fail 'inner ext4 capacity mismatch'
 private_image "$images/linux-boot.fat" 1073741824 || fail 'unsafe ESP image'
 clean_ext4 "$images/root.ext4" 171a4adb916b47639e6f722b4a99988f || fail 'unexpected or unclean inner ext4'
 [ "$(hex "$images/linux-boot.fat" 67 4)" = db4a1a17 ] &&
@@ -103,6 +114,11 @@
 rootloop=$(attach -r) || fail 'cannot attach read-only root'
 mount -t ext4 -o ro,noload "$rootloop" /newroot || fail 'read-only root mount failed'
 [ "$(cat /newroot/etc/y700/image-id)" = y700-prc-171a4adb-916b-4763-9e6f-722b4a99988f ] || fail 'unexpected inner image identity'
+receipt=/newroot/var/lib/y700/build/video-player-update.lock.json
+[ "$(readlink -f "$receipt")" = "$receipt" ] &&
+[ -f "$receipt" ] && [ "$(stat -c '%u:%g:%a:%h:%s' "$receipt")" = 0:0:644:1:723 ] &&
+[ "$(sha256sum "$receipt" | cut -d ' ' -f 1)" = 39cd516bc47679ba3c7980dc3ed43a43c1bac80e40fba690c85d33d9794fd5eb ] ||
+    fail 'unexpected inner release receipt'
 # The verified generic root may later persist local changes, including enrollment.
 umount /newroot && losetup -d "$rootloop" || fail 'cannot release verified root'
 rootloop=
--- a/y700-file-trial-shutdown
+++ b/y700-file-trial-shutdown
@@ -16,13 +16,17 @@
 sync
 # systemd may leave API mounts below /oldroot or have already released /boot.
 # Release children first; lazy unmount is used only for in-memory API mounts.
-awk '$5 ~ /^\/oldroot\// {print length($5),$5}' /proc/self/mountinfo | sort -rn > /mount-list
-while read -r len encoded; do
+awk '$5 ~ /^\/oldroot\// {for (i=7;i<=NF;i++) if ($i=="-") {print length($5),$5,$(i+1); break}}' /proc/self/mountinfo | sort -rn > /mount-list
+while read -r len encoded fstype; do
     path=$(printf '%b' "$encoded")
     if ! umount "$path"; then
         case "$path" in
             /oldroot/dev|/oldroot/dev/*|/oldroot/proc|/oldroot/proc/*|/oldroot/sys|/oldroot/sys/*|/oldroot/run|/oldroot/run/*)
-                umount -l "$path" || fail "could not release $path" ;;
+                case "$fstype" in
+                    proc|sysfs|devtmpfs|devpts|tmpfs|cgroup|cgroup2|mqueue|securityfs|debugfs|tracefs|pstore|bpf|configfs)
+                        umount -l "$path" || fail "could not release $path" ;;
+                    *) fail "busy $fstype at $path" ;;
+                esac ;;
             *) fail "could not release $path" ;;
         esac
     fi
@@ -31,7 +35,7 @@
 while read -r loop; do
     file=/sys/class/block/${loop##*/}/loop/backing_file
     if [ -e "$file" ]; then
-        case "$(cat "$file")" in */var/lib/y700-trial/dev12.5/root.ext4|*/var/lib/y700-trial/dev12.5/linux-boot.fat) ;; *) fail 'unexpected loop backing';; esac
+        case "$(cat "$file")" in */var/lib/y700-trial/dev12.10/root.ext4|*/var/lib/y700-trial/dev12.10/linux-boot.fat) ;; *) fail 'unexpected loop backing';; esac
         losetup -d "$loop" || [ ! -e "$file" ] || fail "cannot detach $loop"
     fi
     for wait in 1 2 3 4 5; do [ -e "$file" ] || break; sleep 1; done
