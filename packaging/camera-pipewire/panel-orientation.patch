--- a/spa/plugins/libcamera/libcamera-source.cpp
+++ b/spa/plugins/libcamera/libcamera-source.cpp
@@ -40,0 +41 @@
+#include "panel-orientation.h"
@@ -140,0 +142,7 @@
+	const uint64_t *panel_orientation = nullptr;
+	int panel_direction = 0;
+
+	~impl() {
+		if (panel_orientation)
+			munmap((void *)panel_orientation, sizeof(*panel_orientation));
+	}
--- a/spa/plugins/libcamera/libcamera-utils.cpp
+++ b/spa/plugins/libcamera/libcamera-utils.cpp
@@ -26,0 +27,10 @@
+	/* Only the three integrated PRC cameras have a board mounting contract.
+	 * The front camera looks in the opposite direction across the screen. */
+	if (impl->device_id == "/base/soc@0/cci@ac15000/i2c-bus@1/camera@10")
+		impl->panel_direction = -1;
+	else if (impl->device_id == "/base/soc@0/cci@ac15000/i2c-bus@0/camera@20" ||
+	         impl->device_id == "/base/soc@0/cci@ac16000/i2c-bus@0/camera@36")
+		impl->panel_direction = 1;
+	if (impl->panel_direction)
+		impl->panel_orientation = y700_map_orientation(0, nullptr);
+
@@ -45,0 +56,4 @@
+	if (impl->panel_orientation) {
+		munmap((void *)impl->panel_orientation, sizeof(*impl->panel_orientation));
+		impl->panel_orientation = nullptr;
+	}
@@ -931,0 +946,8 @@
+	if (b->videotransform && impl->panel_orientation) {
+		uint32_t native = libcamera_orientation_to_spa_transform_value(impl->config->orientation);
+		/* Retain all mirrored and non-PRC orientations as negotiated. */
+		if (native <= SPA_META_TRANSFORMATION_270) {
+			int delta = (int)y700_panel_quarters(impl->panel_orientation) * impl->panel_direction;
+			b->videotransform->transform = (native + delta + 4) % 4;
+		}
+	}
