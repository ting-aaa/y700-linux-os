# Debian's 55xfce4-session has already resolved the session-manager alternative.
case ${BASESTARTUP:-} in
    startxfce4|xfce4-session)
        # X11 has a single desktop scale. Only select the tablet default if the
        # internal panel is the sole active output when the session starts.
        if grep -zFxq 'lenovo,asphalt' /proc/device-tree/compatible 2>/dev/null &&
            LC_ALL=C xrandr --current | awk '
                $2 == "connected" {
                    for (i = 3; i <= NF; ++i) {
                        if ($i ~ /^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+$/) {
                            active++
                            if ($1 == "DSI-1" && $i ~ /^(1600x2560|2560x1600)[+-]/)
                                panel = 1
                            break
                        }
                    }
                }
                END { exit !(active == 1 && panel) }'
        then
            XDG_CONFIG_DIRS=/usr/share/y700/tablet-xdg:${XDG_CONFIG_DIRS:-/etc/xdg}
            export XDG_CONFIG_DIRS
        fi
        ;;
esac
