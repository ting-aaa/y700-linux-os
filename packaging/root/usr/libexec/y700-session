#!/bin/bash
set -euo pipefail
[[ ${XDG_SESSION_TYPE:-x11} == x11 ]] || exit 0
state=${XDG_STATE_HOME:-$HOME/.local/state}/y700
mkdir -p "$state"
if [[ ! -e "$state/panel-audio-v1" ]]; then
    /usr/libexec/y700-panel-audio &
fi
# Initialize the panel once. Onboard reads its defaults from GSettings.
initialize_defaults() {
    xfconf-query -c xfce4-panel -p /panels/panel-1/size -n -t uint -s 64
    xfconf-query -c xfce4-panel -p /panels/panel-1/icon-size -n -t uint -s 40
}
if [[ ! -f "$state/desktop-defaults-v1" ]]; then
    # A busy settings daemon must not prevent touch mapping.
    set +e
    (set -e; initialize_defaults)
    result=$?
    set -e
    if [[ $result == 0 ]]; then
        touch "$state/desktop-defaults-v1"
    else
        echo 'Desktop defaults incomplete; retrying at next login.' >&2
    fi
fi
exec /usr/bin/y700-display --watch
