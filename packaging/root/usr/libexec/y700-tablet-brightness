#!/usr/bin/python3
from pathlib import Path
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gio, GLib, Gtk


DEVICE = "ktz8866-backlight"
BACKLIGHT = Path("/sys/class/backlight") / DEVICE
LOGIN = "org.freedesktop.login1"
SESSION = "/org/freedesktop/login1/session/auto"
AUTO_KEY = "automatic-brightness"
SENSOR = "net.hadess.SensorProxy"
SENSOR_PATH = "/net/hadess/SensorProxy"
CHINESE = GLib.get_language_names()[0].startswith("zh")


def label(english, chinese):
    return chinese if CHINESE else english


def read_level():
    maximum = int((BACKLIGHT / "max_brightness").read_text())
    current = int((BACKLIGHT / "brightness").read_text())
    if maximum < 1 or not 0 <= current <= maximum:
        raise ValueError("Invalid internal backlight range")
    return current, maximum


class BrightnessWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=label("Tablet brightness", "平板屏幕亮度"))
        self.set_default_size(412, -1)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_resizable(False)
        self.original = None
        self.pending = False
        source = Gio.SettingsSchemaSource.get_default()
        schema = source.lookup("org.y700.tablet", True) if source else None
        self.settings = Gio.Settings.new_full(schema, None, None) if schema and schema.has_key(AUTO_KEY) else None
        self.watch = 0
        self.poll = 0
        self.sensor = None
        self.query = None
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, margin=24)
        self.add(content)

        controls = Gtk.Box(spacing=12, homogeneous=True)
        content.add(controls)
        self.dimmer = self.button("−", label("Decrease brightness", "降低亮度"), self.adjust, -1)
        controls.add(self.dimmer)
        self.level = Gtk.Label(label="—")
        self.level.get_style_context().add_class("title")
        self.level.get_accessible().set_description(label("Current brightness", "当前亮度"))
        controls.add(self.level)
        self.brighter = self.button("+", label("Increase brightness", "提高亮度"), self.adjust, 1)
        controls.add(self.brighter)

        self.bar = Gtk.LevelBar.new_for_interval(0, 1)
        content.add(self.bar)
        presets = Gtk.Box(spacing=8, homogeneous=True)
        content.add(presets)
        self.presets = []
        for percent in (5, 25, 50, 75, 100):
            caption = f"{percent}%"
            name = label(f"Set brightness to {caption}", f"将亮度设为 {caption}")
            button = self.button(caption, name, self.set_percent, percent)
            self.presets.append((percent, button))
            presets.add(button)
        text = label("Restore opening level", "恢复打开时的亮度")
        self.restore = self.button(text, text, self.restore_level)
        content.add(self.restore)
        toggle = Gtk.CheckButton(label=label("Automatic brightness", "自动亮度"))
        toggle.set_size_request(-1, 56)
        content.add(toggle)
        self.auto_hint = Gtk.Label(wrap=True, max_width_chars=44, xalign=0)
        self.auto_hint.set_no_show_all(True)
        content.add(self.auto_hint)
        self.status = Gtk.Label(wrap=True, xalign=0)
        self.status.set_no_show_all(True)
        content.add(self.status)
        self.connect("focus-in-event", self.focused)
        self.connect("destroy", self.close_monitor)
        if self.settings:
            self.settings.bind(AUTO_KEY, toggle, "active", Gio.SettingsBindFlags.DEFAULT)
            self.pref_handler = self.settings.connect("changed::" + AUTO_KEY, self.mode_changed)
            self.mode_changed()
        else:
            toggle.set_sensitive(False)
        self.refresh()
        self.show_all()

    def button(self, text, name, handler, *args):
        button = Gtk.Button(label=text)
        button.set_size_request(50, 56)
        button.get_accessible().set_name(name)
        button.connect("clicked", handler, *args)
        return button

    def show_status(self, message):
        self.status.set_text(message)
        self.status.set_visible(bool(message))

    def focused(self, *_):
        self.show_status("")
        self.refresh()

    def mode_changed(self, *_):
        automatic = self.settings.get_boolean(AUTO_KEY)
        self.auto_hint.set_visible(automatic)
        if automatic and not self.watch:
            self.sensor_hint(False)
            self.watch = Gio.bus_watch_name(Gio.BusType.SYSTEM, SENSOR, Gio.BusNameWatcherFlags.NONE,
                                            self.sensor_appeared, self.sensor_gone)
            self.poll = GLib.timeout_add_seconds(2, self.observe)
        elif not automatic:
            self.stop_monitor()

    def sensor_hint(self, available):
        self.auto_hint.set_text(
            label("Manual adjustment turns automatic brightness off.", "手动调节会关闭自动亮度。")
            if available else label("Waiting for the ambient light sensor.", "正在等待环境光传感器。"))

    def sensor_appeared(self, bus, _name, owner):
        self.sensor_gone()
        self.sensor = (bus, owner)
        self.observe()

    def sensor_gone(self, *_):
        if self.query:
            self.query.cancel()
        self.query = self.sensor = None
        self.sensor_hint(False)

    def observe(self):
        self.refresh()
        if self.sensor and self.query is None:
            # SensorProxy can unicast changes to the claiming process. The
            # settings window checks availability without claiming or starting it.
            bus, owner = self.sensor
            self.query = Gio.Cancellable()
            bus.call(owner, SENSOR_PATH, "org.freedesktop.DBus.Properties", "Get",
                     GLib.Variant("(ss)", (SENSOR, "HasAmbientLight")), GLib.VariantType.new("(v)"),
                     Gio.DBusCallFlags.NO_AUTO_START, 1500, self.query, self.observed, self.query)
        return GLib.SOURCE_CONTINUE

    def observed(self, bus, result, query):
        try:
            available, = bus.call_finish(result).unpack()
        except GLib.Error:
            available = False
        if self.query is query:
            self.query = None
            self.sensor_hint(available is True)

    def stop_monitor(self):
        if self.watch:
            Gio.bus_unwatch_name(self.watch)
            self.watch = 0
        if self.poll:
            GLib.source_remove(self.poll)
            self.poll = 0
        self.sensor_gone()

    def close_monitor(self, *_):
        if self.settings:
            self.settings.disconnect(self.pref_handler)
        self.stop_monitor()

    def refresh(self):
        try:
            current, maximum = read_level()
        except (OSError, ValueError):
            self.level.set_text("—")
            self.bar.set_value(0)
            for button in (self.dimmer, self.brighter, self.restore, *(b for _, b in self.presets)):
                button.set_sensitive(False)
            self.show_status(label("Internal backlight unavailable.", "无法读取内屏背光。"))
            return None
        if self.original is None:
            self.original = current
        minimum = max(1, maximum * 5 // 100)
        self.level.set_text(f"{round(current * 100 / maximum)}%")
        self.bar.set_value(current / maximum)
        self.dimmer.set_sensitive(not self.pending and current > minimum)
        self.brighter.set_sensitive(not self.pending and current < maximum)
        self.restore.set_sensitive(not self.pending and 0 < self.original <= maximum and current != self.original)
        for percent, button in self.presets:
            button.set_sensitive(not self.pending and current != max(minimum, maximum * percent // 100))
        return current, maximum, minimum

    def adjust(self, _button, direction):
        values = self.refresh()
        if values:
            current, maximum, minimum = values
            step = max(1, round(maximum / 100))
            self.request(current, max(minimum, min(maximum, current + step * direction)))

    def set_percent(self, _button, percent):
        values = self.refresh()
        if values:
            current, maximum, minimum = values
            self.request(current, max(minimum, maximum * percent // 100))

    def restore_level(self, _button):
        values = self.refresh()
        if values:
            current, maximum, _ = values
            if 0 < self.original <= maximum:
                self.request(current, self.original)

    def request(self, current, target):
        if self.pending or current == target:
            return
        if self.settings and self.settings.get_boolean(AUTO_KEY) and not self.settings.set_boolean(AUTO_KEY, False):
            self.show_status(label("Automatic brightness is managed for this account.",
                                   "此账户的自动亮度由管理员管理。"))
            return
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        except GLib.Error:
            self.show_status(label("The login service is unavailable.", "登录服务不可用。"))
            return
        self.pending = True
        self.show_status("")
        self.refresh()
        # logind authorizes the active seat and the session owner. Its default
        # call flags do not request an interactive authorization prompt.
        bus.call(
            LOGIN, SESSION, LOGIN + ".Session", "SetBrightness",
            GLib.Variant("(ssu)", ("backlight", DEVICE, target)), None,
            Gio.DBusCallFlags.NONE, 5000, None, self.finished, target,
        )

    def finished(self, bus, result, target):
        self.pending = False
        values = self.refresh()
        try:
            bus.call_finish(result)
        except GLib.Error:
            self.show_status(label("Could not set brightness for this session.", "当前会话无法设置亮度。"))
            return
        if values and values[0] != target:
            self.show_status(label("The backlight reported a different level.", "背光报告的亮度与设定不同。"))


def activate(app):
    window = app.get_active_window()
    if window is None:
        window = BrightnessWindow(app)
    else:
        window.refresh()
    window.present()


if __name__ == "__main__":
    app = Gtk.Application(application_id="org.y700.TabletBrightness")
    app.connect("activate", activate)
    sys.exit(app.run(sys.argv))
