#!/usr/bin/python3
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gio, GLib, Gtk


SCHEMA = "org.y700.tablet"
KEY = "auto-rotate"
SENSOR_PROXY = "net.hadess.SensorProxy"
SENSOR_PATH = "/net/hadess/SensorProxy"
PROPERTIES = "org.freedesktop.DBus.Properties"
CHINESE = GLib.get_language_names()[0].startswith("zh")


def label(english, chinese):
    return chinese if CHINESE else english


class RotationWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=label("Tablet rotation", "平板屏幕旋转"))
        self.set_default_size(420, -1)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_resizable(False)
        self.watch = 0
        self.poll = 0
        self.sensor = None
        self.request = None
        self.sensor_available = False
        self.connect("destroy", self.shutdown)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        content.set_border_width(24)
        self.add(content)

        toggle = Gtk.CheckButton(label=label("Rotate automatically", "自动旋转屏幕"))
        toggle.set_size_request(-1, 72)
        content.add(toggle)

        self.status = Gtk.Label(wrap=True, max_width_chars=46, xalign=0)
        content.add(self.status)

        source = Gio.SettingsSchemaSource.get_default()
        schema = source.lookup(SCHEMA, True) if source else None
        self.settings = Gio.Settings.new_full(schema, None, None) if schema else None
        if self.settings is None:
            toggle.set_sensitive(False)
        else:
            self.settings.bind(KEY, toggle, "active", Gio.SettingsBindFlags.DEFAULT)
            self.preference_handler = self.settings.connect(f"changed::{KEY}", self.preference_changed)
        self.preference_changed()
        self.show_all()

    def preference_changed(self, *_):
        if self.settings and self.settings.get_boolean(KEY):
            if not self.watch:
                self.watch = Gio.bus_watch_name(
                    Gio.BusType.SYSTEM, SENSOR_PROXY, Gio.BusNameWatcherFlags.NONE,
                    self.sensor_appeared, self.sensor_gone,
                )
        else:
            self.stop_watch()
        self.update_status()

    def sensor_appeared(self, bus, _name, owner):
        self.clear_sensor()
        self.sensor = bus, owner
        self.poll = GLib.timeout_add_seconds(2, self.query_sensor)
        self.query_sensor()
        self.update_status()

    def query_sensor(self):
        # iio-sensor-proxy sends property updates only to clients claiming sensors.
        if self.request is None:
            bus, owner = self.sensor
            self.request = Gio.Cancellable()
            bus.call(
                owner, SENSOR_PATH, PROPERTIES, "Get",
                GLib.Variant("(ss)", (SENSOR_PROXY, "HasAccelerometer")), GLib.VariantType.new("(v)"),
                Gio.DBusCallFlags.NO_AUTO_START, 1500, self.request, self.sensor_reply, self.request,
            )
        return GLib.SOURCE_CONTINUE

    def sensor_reply(self, bus, result, request):
        try:
            available, = bus.call_finish(result).unpack()
        except GLib.Error:
            available = False
        # Discard a reply already pending when the preference or bus owner changed.
        if request is self.request:
            self.request = None
            self.sensor_available = available is True
            self.update_status()

    def sensor_gone(self, *_):
        self.clear_sensor()
        self.update_status()

    def clear_sensor(self):
        if self.poll:
            GLib.source_remove(self.poll)
            self.poll = 0
        if self.request is not None:
            self.request.cancel()
            self.request = None
        self.sensor = None
        self.sensor_available = False

    def stop_watch(self):
        if self.watch:
            Gio.bus_unwatch_name(self.watch)
            self.watch = 0
        self.clear_sensor()

    def shutdown(self, _window):
        if self.settings is not None:
            self.settings.disconnect(self.preference_handler)
        self.stop_watch()

    def update_status(self, *_):
        if self.settings is None:
            message = label("Rotation settings are unavailable.", "旋转设置暂时不可用。")
        elif not self.settings.get_boolean(KEY):
            message = label("Current orientation is locked.", "已锁定当前屏幕方向。")
        elif self.sensor_available:
            message = label("Automatic rotation enabled.", "已启用自动旋转。")
        else:
            message = label(
                "Automatic rotation enabled. Waiting for an orientation sensor.",
                "已启用自动旋转，正在等待方向传感器。",
            )
        self.status.set_text(message)


def activate(app):
    window = app.get_active_window() or RotationWindow(app)
    window.present()


if __name__ == "__main__":
    app = Gtk.Application(application_id="org.y700.TabletRotation")
    app.connect("activate", activate)
    sys.exit(app.run(sys.argv))
