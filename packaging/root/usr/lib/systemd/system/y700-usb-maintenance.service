[Unit]
Description=Y700 USB maintenance gadget
Requires=sys-kernel-config.mount
After=sys-kernel-config.mount
Before=NetworkManager.service y700-maintenance-sshd.service
ConditionPathExists=/etc/y700/maintenance.env

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/y700-usb-maintenance start
ExecStop=/usr/libexec/y700-usb-maintenance stop
TimeoutStartSec=50

[Install]
WantedBy=multi-user.target
