+QString CameraSelectorDialog::displayName(const QString &id)
+{
+	const bool chinese = QLocale().language() == QLocale::Chinese;
+	if (id == QStringLiteral("/base/soc@0/cci@ac15000/i2c-bus@0/camera@20"))
+		return chinese ? QStringLiteral("后置主摄") : QStringLiteral("Rear main camera");
+	if (id == QStringLiteral("/base/soc@0/cci@ac15000/i2c-bus@1/camera@10"))
+		return chinese ? QStringLiteral("前置摄像头") : QStringLiteral("Front camera");
+	if (id == QStringLiteral("/base/soc@0/cci@ac16000/i2c-bus@0/camera@36"))
+		return chinese ? QStringLiteral("后置微距") : QStringLiteral("Rear macro camera");
+	return id;
