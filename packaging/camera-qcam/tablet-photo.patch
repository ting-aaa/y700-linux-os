diff --git a/src/apps/qcam/photo_store.cpp b/src/apps/qcam/photo_store.cpp
new file mode 100644
index 0000000..9c3dbbc
--- /dev/null
+++ b/src/apps/qcam/photo_store.cpp
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "photo_store.h"
+
+#include <QDateTime>
+#include <QDir>
+#include <QFileInfo>
+#include <QImage>
+#include <QImageWriter>
+#include <QTemporaryFile>
+
+bool qcam_photo::save(const QImage &image, const QString &directory, QString *path,
+		      QString *error)
+{
+	path->clear();
+	error->clear();
+	if (image.isNull()) {
+		*error = QStringLiteral("No camera frame");
+		return false;
+	}
+
+	QDir pictures(directory);
+	if (directory.isEmpty() || !pictures.isAbsolute() || !pictures.mkpath(".")) {
+		*error = QStringLiteral("Pictures folder unavailable (%1)").arg(directory);
+		return false;
+	}
+
+	const QString timestamp = QDateTime::currentDateTime().toString("yyyyMMdd-HHmmss-zzz");
+	QTemporaryFile file(pictures.filePath(".Y700-" + timestamp + "-XXXXXX"));
+	if (!file.open()) {
+		*error = file.errorString();
+		return false;
+	}
+
+	QImageWriter writer(&file, "jpeg");
+	writer.setQuality(95);
+	if (!writer.write(image)) {
+		*error = writer.errorString();
+		return false;
+	}
+	if (!file.flush() || file.error() != QFileDevice::NoError) {
+		*error = file.errorString();
+		return false;
+	}
+
+	/* Publish only the finished JPEG. rename() fails if the name exists. */
+	const QString name = QFileInfo(file.fileName()).fileName().mid(1) + ".jpg";
+	const QString destination = pictures.filePath(name);
+	if (!file.rename(destination)) {
+		*error = file.errorString();
+		return false;
+	}
+	file.setAutoRemove(false);
+	*path = destination;
+	return true;
+}
