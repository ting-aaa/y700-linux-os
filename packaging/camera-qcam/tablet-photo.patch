+void MainWindow::takePhoto()
+{
+	if (savingPhoto_ || !shutter_->isEnabled())
+		return;
+
+	/* The raster viewfinder copies the full camera frame before its buffer is reused. */
+	const QImage image = viewfinder_->getCurrentImage();
+	const QString directory = QStandardPaths::writableLocation(QStandardPaths::PicturesLocation);
+	const bool chinese = QLocale().language() == QLocale::Chinese;
+	savingPhoto_ = true;
+	shutter_->setEnabled(false);
+	statusBar()->showMessage(chinese ? QStringLiteral("正在保存…") : QStringLiteral("Saving…"));
+	photoWorkers_.start([this, image, directory, chinese]() {
+		QString path, error;
+		bool saved = qcam_photo::save(image, directory, &path, &error);
+		const QString message = saved
+			? (chinese ? QStringLiteral("已保存 %1") : QStringLiteral("Saved %1")).arg(path)
+			: (chinese ? QStringLiteral("保存失败：%1") : QStringLiteral("Could not save: %1")).arg(error);
+		QMetaObject::invokeMethod(this, [this, message, saved]() {
+			savingPhoto_ = false;
+			statusBar()->showMessage(message, saved ? 8000 : 0);
+		}, Qt::QueuedConnection);
+	});
+}
