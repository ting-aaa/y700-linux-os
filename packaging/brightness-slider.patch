+    def touch_begin(self, _scale, event):
+        if event.type == Gdk.EventType.TOUCH_BEGIN and self.touch_sequence is None:
+            self.touch_sequence = event.get_event_sequence()
+        return False
+
+    def touch_finished(self, scale, event):
+        if event.type not in (Gdk.EventType.TOUCH_END, Gdk.EventType.TOUCH_CANCEL):
+            return
+        if self.touch_sequence != event.get_event_sequence():
+            return
+        self.touch_sequence = None
+        if event.type == Gdk.EventType.TOUCH_END:
+            self.slide(scale)
+        else:
+            self.refresh()
+
+    def slide(self, scale):
+        percent = round(scale.get_value())
+        if self.touch_sequence is not None:
+            # Let GTK track the contact before committing the final level.
+            self.level.set_text(f"{percent}%")
+            return
+        try:
+            current, maximum = read_level()
+        except (OSError, ValueError):
+            self.refresh()
+            return
+        self.request(current, max(1, maximum * percent // 100))
