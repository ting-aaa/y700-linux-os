+/* Observe the GtkRange's native input without claiming its gesture.  A
+ * release is handled after GTK has applied the final thumb position. */
+static gboolean
+parole_player_scrub_event(GtkWidget *widget, GdkEvent *event, ParolePlayer *player) {
+    if (event->type == GDK_GRAB_BROKEN ||
+        (event->type == GDK_TOUCH_CANCEL &&
+         event->touch.sequence == player->priv->scrub_sequence)) {
+        parole_player_end_scrub(player);
+    } else if (!player->priv->scrub_active && gtk_widget_get_scale_factor(widget) >= 2 &&
+               ((event->type == GDK_BUTTON_PRESS && event->button.button == GDK_BUTTON_PRIMARY) ||
+                event->type == GDK_TOUCH_BEGIN)) {
+        player->priv->scrub_active = TRUE;
+        player->priv->scrub_sequence = gdk_event_get_event_sequence(event);
+    }
+    return FALSE;
+}
+
+static void
+parole_player_scrub_after(GtkWidget *widget, GdkEvent *event, ParolePlayer *player) {
+    if (!player->priv->scrub_active ||
+        gdk_event_get_event_sequence(event) != player->priv->scrub_sequence)
+        return;
+    if (event->type == GDK_TOUCH_END ||
+        (event->type == GDK_BUTTON_RELEASE && event->button.button == GDK_BUTTON_PRIMARY)) {
+        gboolean changed = player->priv->scrub_changed;
+        parole_player_end_scrub(player);
+        if (changed && gtk_widget_is_sensitive(widget))
+            parole_gst_seek(PAROLE_GST(player->priv->gst), gtk_range_get_value(GTK_RANGE(widget)));
+    }
+}
