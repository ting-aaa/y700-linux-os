+static gboolean
+is_sae_request(NMActRequest *req)
+{
+    NMSettingWirelessSecurity *security;
+
+    security =
+        nm_connection_get_setting_wireless_security(nm_act_request_get_applied_connection(req));
+    return security && nm_streq0(nm_setting_wireless_security_get_key_mgmt(security), "sae");
+}
+
+static void
+request_new_sae_password(NMDeviceWifi *self, NMActRequest *req, NMDeviceStateReason reason)
+{
+    /* Only clear the in-memory applied connection. Persistence and Cancel remain
+     * the responsibility of the normal NetworkManager secret-agent machinery. */
+    nm_act_request_clear_secrets(req);
+    nm_device_state_changed(NM_DEVICE(self), NM_DEVICE_STATE_NEED_AUTH, reason);
+    wifi_secrets_get_secrets(self,
+                             NM_SETTING_WIRELESS_SECURITY_SETTING_NAME,
+                             NM_SECRET_AGENT_GET_SECRETS_FLAG_ALLOW_INTERACTION
+                                 | NM_SECRET_AGENT_GET_SECRETS_FLAG_REQUEST_NEW);
+}
+
+static void
+supplicant_iface_notify_wpa_sae_mismatch_cb(NMSupplicantInterface *iface, NMDeviceWifi *self)
+{
+    NMDevice     *device = NM_DEVICE(self);
+    NMActRequest *req    = nm_device_get_act_request(device);
+
+    if (nm_device_get_state(device) != NM_DEVICE_STATE_CONFIG || !req || !is_sae_request(req))
+        return;
+
+    _LOGI(LOGD_DEVICE | LOGD_WIFI,
+          "Activation: (wifi) SAE password mismatch reported by supplicant, asking for new key");
+    cleanup_association_attempt(self, TRUE);
+    request_new_sae_password(self, req, NM_DEVICE_STATE_REASON_SUPPLICANT_DISCONNECT);
+}
+
+/* A legacy AP may reject an SAE confirmation with status 1 (unspecified).
+ * This alone says nothing about the password. Remember only the live attempt. */
+static void
+supplicant_iface_auth_reject_unspecified(NMSupplicantInterface *iface, NMDeviceWifi *self)
+{
+    NMDevice     *device = NM_DEVICE(self);
+    NMActRequest *req    = nm_device_get_act_request(device);
+    const char   *selected;
+
+    if (nm_device_get_state(device) != NM_DEVICE_STATE_CONFIG || !req || !is_sae_request(req))
+        return;
+    selected = g_object_get_data(G_OBJECT(req), "wifi-explicit-ap");
+    if (selected && selected[0])
+        g_object_set_data(G_OBJECT(req), "wifi-sae-rejected", GINT_TO_POINTER(TRUE));
+}
+
+static void
+clear_sae_retry(NMDeviceWifiPrivate *priv)
+{
+    g_clear_pointer(&priv->sae_retry_ap, g_free);
+    g_clear_pointer(&priv->sae_retry_uuid, g_free);
+    priv->sae_retry_until_msec = 0;
+}
+
+static void
+remember_failed_sae_selection(NMDeviceWifi *self, NMActRequest *req)
+{
+    NMDeviceWifiPrivate *priv = NM_DEVICE_WIFI_GET_PRIVATE(self);
+    const char          *path = g_object_get_data(G_OBJECT(req), "wifi-explicit-ap");
+    NMWifiAP            *ap;
+
+    if (!path || !path[0] || !g_object_get_data(G_OBJECT(req), "wifi-sae-rejected"))
+        return;
+    ap = nm_wifi_ap_lookup_for_device(NM_DEVICE(self), path);
+    if (!ap || nm_wifi_ap_get_fake(ap))
+        return;
+
+    nm_strdup_reset(&priv->sae_retry_ap, path);
+    nm_strdup_reset(&priv->sae_retry_uuid,
+                    nm_connection_get_uuid(nm_act_request_get_applied_connection(req)));
+    priv->sae_retry_uid = nm_auth_subject_get_unix_process_uid(
+        nm_active_connection_get_subject(NM_ACTIVE_CONNECTION(req)));
+    priv->sae_retry_until_msec =
+        nm_utils_get_monotonic_timestamp_msec() + 180 * NM_UTILS_MSEC_PER_SEC;
+    _LOGD(LOGD_WIFI, "legacy SAE authentication rejection followed by association timeout");
+}
+
+static void
+check_sae_reselection(NMDeviceWifi *self, NMActRequest *req, NMWifiAP *selected)
+{
+    NMDeviceWifiPrivate *priv   = NM_DEVICE_WIFI_GET_PRIVATE(self);
+    NMActiveConnection  *active = NM_ACTIVE_CONNECTION(req);
+    const char          *path;
+
+    if (nm_active_connection_get_activation_reason(active) != NM_ACTIVATION_REASON_USER_REQUEST
+        || !nm_active_connection_get_user_requested(active)
+        || g_object_get_data(G_OBJECT(req), "wifi-explicit-ap"))
+        return;
+
+    /* Capture the caller's specific object before stage 1 may choose a compatible
+     * or synthetic AP. A later stage 1 on the same request must not replace it. */
+    path = selected && !nm_wifi_ap_get_fake(selected)
+               ? nm_dbus_object_get_path(NM_DBUS_OBJECT(selected))
+               : "";
+    g_object_set_data_full(G_OBJECT(req), "wifi-explicit-ap", g_strdup(path), g_free);
+    if (!priv->sae_retry_ap)
+        return;
+
+    if (path[0] && is_sae_request(req)
+        && nm_utils_get_monotonic_timestamp_msec() <= priv->sae_retry_until_msec
+        && priv->sae_retry_uid
+               == nm_auth_subject_get_unix_process_uid(nm_active_connection_get_subject(active))
+        && nm_streq(path, priv->sae_retry_ap)
+        && nm_streq(nm_connection_get_uuid(nm_act_request_get_applied_connection(req)),
+                    priv->sae_retry_uuid))
+        g_object_set_data(G_OBJECT(req), "wifi-sae-reenter", GINT_TO_POINTER(TRUE));
+
+    clear_sae_retry(priv);
+}
