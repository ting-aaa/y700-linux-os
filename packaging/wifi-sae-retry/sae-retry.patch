         }
     } else {
+        remember_failed_sae_selection(self, req);
         _LOGW(LOGD_DEVICE | LOGD_WIFI,
               "Activation: (wifi) association took too long, failing activation");
         nm_device_state_changed(device,
@@ -3137,6 +3276,7 @@ act_stage1_prepare(NMDevice *device, NMDeviceStateReason *out_failure_reason)
         ap_path = nm_active_connection_get_specific_object(NM_ACTIVE_CONNECTION(req));
         ap      = ap_path ? nm_wifi_ap_lookup_for_device(NM_DEVICE(self), ap_path) : NULL;
     }
+    check_sae_reselection(self, req, ap);
     if (!ap)
         ap = nm_wifi_aps_find_first_compatible(&priv->aps_lst_head, connection);
 
@@ -3319,6 +3459,14 @@ act_stage2_config(NMDevice *device, NMDeviceStateReason *out_failure_reason)
     s_wireless = nm_connection_get_setting_wireless(connection);
     nm_assert(s_wireless);
 
+    if (g_object_steal_data(G_OBJECT(req), "wifi-sae-reenter")) {
+        _LOGI(LOGD_DEVICE | LOGD_WIFI,
+              "Activation: (wifi) selected the failed SAE access point again, requesting credentials");
+        request_new_sae_password(self, req, NM_DEVICE_STATE_REASON_NONE);
+        return NM_ACT_STAGE_RETURN_POSTPONE;
+    }
+    g_object_set_data(G_OBJECT(req), "wifi-sae-rejected", NULL);
+
     /* If we need secrets, get them */
     setting_name = nm_connection_need_secrets(connection, NULL);
     if (setting_name) {
@@ -3554,6 +3702,7 @@ device_state_changed(NMDevice           *device,
         _indicate_addressing_running_reset(self);
         break;
     case NM_DEVICE_STATE_ACTIVATED:
+        clear_sae_retry(priv);
         activation_success_handler(device);
         break;
     case NM_DEVICE_STATE_FAILED:
@@ -3828,6 +3977,7 @@ finalize(GObject *object)
     nm_assert(c_list_is_empty(&priv->aps_lst_head));
     nm_assert(g_hash_table_size(priv->aps_idx_by_supplicant_path) == 0);
 
+    clear_sae_retry(priv);
     g_hash_table_unref(priv->aps_idx_by_supplicant_path);
 
     G_OBJECT_CLASS(nm_device_wifi_parent_class)->finalize(object);
