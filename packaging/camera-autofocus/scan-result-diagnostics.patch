+ContrastScan::State ContrastScan::finish(State state, const char *reason, Diagnostic *diagnostic)
+{
+	if (diagnostic) {
+		static constexpr const char *phases[] = { "coarse", "fine", "verify" };
+		diagnostic->phase = phases[static_cast<size_t>(phase_)];
+		diagnostic->reason = reason;
+	}
+	return state_ = state;
+}
