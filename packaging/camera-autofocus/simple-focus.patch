+void SimpleCameraData::setFocusControls(bool available)
+{
+	if (!focusLens_ || !!controlInfo_.count(controls::AfMode.id()) == available)
+		return;
+	ControlInfoMap::Map map(controlInfo_.begin(), controlInfo_.end());
+	if (available) {
+		const std::array<ControlValue, 2> modes = {
+			static_cast<int32_t>(controls::AfModeManual), static_cast<int32_t>(controls::AfModeAuto)
+		};
+		map.emplace(&controls::AfMode, ControlInfo(modes));
+		map.emplace(&controls::AfTrigger, ControlInfo(controls::AfTriggerValues));
+		map.emplace(&controls::AfState, ControlInfo(controls::AfStateValues));
+	} else {
+		map.erase(&controls::AfMode);
+		map.erase(&controls::AfTrigger);
+		map.erase(&controls::AfState);
+	}
+	controlInfo_ = ControlInfoMap(std::move(map), controls::controls);
+}
+
+void SimpleCameraData::resetFocus()
+{
+	focusRunning_ = false;
+	focus_.reset(focusMin_, focusMax_);
+	if (focusTouched_) {
+		focusLens_->releaseFocus();
+		focusTouched_ = false;
+	}
+}
+
+void SimpleCameraData::focusOutput(Request *request, FrameBuffer *buffer)
+{
+	if (!focusRunning_ || !request || !request->findBuffer(focusStream_) ||
+	    (buffer && request->findBuffer(focusStream_) != buffer))
+		return;
+	const ControlList &ctrls = request->controls();
+	std::optional<bool> automatic;
+	if (auto mode = ctrls.get(controls::AfMode))
+		automatic = *mode == controls::AfModeAuto;
+	auto action = ContrastScan::Trigger::None;
+	if (auto value = ctrls.get(controls::AfTrigger)) {
+		if (*value == controls::AfTriggerStart)
+			action = ContrastScan::Trigger::Start;
+		else if (*value == controls::AfTriggerCancel)
+			action = ContrastScan::Trigger::Cancel;
+	}
+	focus_.request(automatic, action);
+	const uint64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count();
+	const bool valid = buffer && buffer->metadata().status == FrameMetadata::FrameSuccess;
+	if (!valid) {
+		/* A failed RGB frame may not produce IPA statistics. */
+		if (auto *info = frameInfo_.find(request->sequence()))
+			info->metadataRequired = false;
+	}
+	auto state = !valid ? focus_.failedFrame() : focus_.frame(now, buffer->metadata().timestamp, [this](int position) {
+		focusTouched_ = true;
+		return focusLens_->setFocusPosition(position) == 0;
+	}, [this, buffer]() -> std::optional<double> {
+		if (buffer->planes().size() != 1 || buffer->metadata().planes().size() != 1)
+			return {};
+		DmaSyncer sync(buffer->planes()[0].fd, DmaSyncer::SyncType::Read);
+		MappedFrameBuffer mapped(buffer, MappedFrameBuffer::MapFlag::Read);
+		if (!mapped.isValid() || mapped.planes().size() != 1)
+			return {};
+		const auto plane = mapped.planes()[0];
+		const auto &cfg = focusStream_->configuration();
+		return ContrastScan::contrast(plane.data(), std::min<size_t>(plane.size(), buffer->metadata().planes()[0].bytesused),
+					      cfg.size.width, cfg.size.height, cfg.stride, focusPixelBytes_);
+	});
+	int32_t afState = controls::AfStateIdle;
+	switch (state) {
+	case ContrastScan::State::Idle: break;
+	case ContrastScan::State::Scanning: afState = controls::AfStateScanning; break;
+	case ContrastScan::State::Focused: afState = controls::AfStateFocused; break;
+	case ContrastScan::State::Failed: afState = controls::AfStateFailed; break;
+	}
+	request->_d()->metadata().set(controls::AfState, afState);
+}
