+/* Observe the queue without consuming a packet or clearing the doorbell. */
+static void a6xx_hfi_log_vote_timeout(struct a6xx_gmu *gmu, u32 seqnum, u32 intr)
+{
+	struct a6xx_hfi_queue *rx = &gmu->queues[HFI_RESPONSE_QUEUE];
+	struct a6xx_hfi_queue_header *tx = gmu->queues[HFI_COMMAND_QUEUE].header;
+	const u32 size = SZ_4K / sizeof(u32);
+	u32 rd = READ_ONCE(rx->header->read_index);
+	u32 wr = READ_ONCE(rx->header->write_index);
+	u32 head = 0, echo = 0;
+
+	/* Indices are dwords. Use the host allocation bound for the peek. */
+	if (rd < size && wr < size && rd != wr) {
+		dma_rmb();
+		head = READ_ONCE(rx->data[rd]);
+		if (HFI_HEADER_ID(head) == HFI_F2H_MSG_ACK &&
+		    HFI_HEADER_SIZE(head) >= 2 && CIRC_CNT(wr, rd, size) >= 2)
+			echo = READ_ONCE(rx->data[(rd + 1) % size]);
+	}
+
+	dev_err(gmu->dev,
+		"HFI vote snapshot seq=%u intr=%#x cmd_rd=%u cmd_wr=%u rx_rd=%u rx_wr=%u head=%#x echo=%#x perf=%u\n",
+		seqnum, intr, READ_ONCE(tx->read_index), READ_ONCE(tx->write_index),
+		rd, wr, head, echo, gmu->current_perf_index);
+}
