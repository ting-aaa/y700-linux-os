+/* The internal AMIC1 and AMIC4 capture routes use DEC2 and DEC5. */
+static int y700_snd_prepare(struct snd_pcm_substream *substream)
+{
+	static const unsigned int tx_channels[APM_PORT_MAX_AUDIO_CHAN_CNT] = {
+		[2] = PCM_CHANNEL_FL,
+		[5] = PCM_CHANNEL_FR,
+	};
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+
+	if (cpu_dai->id != TX_CODEC_DMA_TX_3)
+		return 0;
+
+	if (substream->runtime->channels != 2)
+		return -EINVAL;
+
+	return snd_soc_dai_set_channel_map(cpu_dai, ARRAY_SIZE(tx_channels),
+					   tx_channels, 0, NULL);
+}
