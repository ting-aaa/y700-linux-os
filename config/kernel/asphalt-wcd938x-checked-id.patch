+static int wcd938x_read_variant(struct regmap *map)
+{
+	unsigned int raw;
+	int ret;
+
+	ret = regmap_read(map, WCD938X_DIGITAL_EFUSE_REG_0, &raw);
+	if (ret)
+		return ret;
+
+	switch (FIELD_GET(WCD938X_ID_MASK, raw)) {
+	case CHIPID_WCD9380:
+		return CHIPID_WCD9380;
+	case CHIPID_WCD9385:
+		return CHIPID_WCD9385;
+	default:
+		return -ENODEV;
+	}
+}
