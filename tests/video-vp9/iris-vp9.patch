 static GstFlowReturn
+gst_v4l2_buffer_pool_dqbuf (GstV4l2BufferPool * pool, GstBuffer ** buffer,
+    gboolean * outstanding, gboolean wait)
+{
+  gboolean pending_error = FALSE;
+  GstFlowReturn ret;
+
+  ret = gst_v4l2_buffer_pool_dqbuf_once (pool, buffer, outstanding, wait,
+      &pending_error);
+  if (pending_error) {
+    ret = gst_v4l2_buffer_pool_dqbuf_once (pool, buffer, outstanding, wait,
+        &pending_error);
+    /* Poll error, source change, flush or EOS before another CAPTURE. */
+    if (pending_error)
+      g_signal_emit (pool, gst_v4l2_buffer_pool_signals[CAPTURE_ERROR_DEQUEUED],
+          0, 0u);
+  }
+  return ret;
+}
