#!/bin/busybox sh
set -eu
export PATH=/bin
/bin/busybox --install -s /bin
trap 'echo ONBOARD_INIT_FAILED; poweroff -f' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
grep -qw y700.onboard_fixture=1 /proc/cmdline
grep -zFxq linux,dummy-virt /proc/device-tree/compatible
test "$(cat /sys/block/vda/ro)" = 1
mount -t ext4 -o ro,noload /dev/vda /lower
mount -t tmpfs tmpfs /upper
mkdir /upper/data /upper/work
mount -t overlay overlay -o lowerdir=/lower,upperdir=/upper/data,workdir=/upper/work /guest
for dir in dev proc sys; do mount --bind "/$dir" "/guest/$dir"; done
mount -t tmpfs tmpfs /guest/run
mkdir -p /guest/opt/onboard-test
cp -a /test/. /guest/opt/onboard-test/
cat > /guest/etc/systemd/system/onboard-fixture.service <<'UNIT'
[Unit]
Description=Isolated Onboard HID hotplug acceptance
Requires=systemd-logind.service dbus.service systemd-udevd.service
After=systemd-logind.service dbus.service systemd-udevd.service
SuccessAction=poweroff-immediate
FailureAction=poweroff-immediate

[Service]
Type=oneshot
TTYPath=/dev/ttyAMA0
StandardOutput=tty
StandardError=tty
TimeoutStartSec=310
ExecStart=/bin/bash /opt/onboard-test/guest.sh
UNIT
exec switch_root /guest /sbin/init
