#!/bin/busybox sh
set -eu
export PATH=/bin
/bin/busybox --install -s /bin
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
interfaces=$(iw dev)
test -z "$interfaces"
# The regulatory request runs on a workqueue. The historical and wrong-key
# cases complete with a fallback world domain, the good case applies the hint.
country=
for attempt in 1 2 3 4 5; do
    country=$(iw reg get | sed -n 's/^country \([A-Z0-9][A-Z0-9]\):.*$/\1/p')
    [ "$country" = CN ] && break
    sleep 1
done
iw reg get
echo "REGDB_DOMAIN=$country"
echo REGDB_PROBE_COMPLETE
poweroff -f
